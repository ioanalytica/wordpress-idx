{
  "name": "wordpress-idx-search-assets",
  "version": "1.3.0",
  "description": "Dev tooling (lint/format) for the WordPress IDX Search plugin assets.",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint assets",
    "lint:css": "stylelint \"assets/**/*.css\"",
    "format": "prettier --write assets",
    "format:check": "prettier --check assets"
  },
  "prettier": {
    "tabWidth": 4,
    "singleQuote": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
